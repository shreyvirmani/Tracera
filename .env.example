APP_NAME=Tracera
ENVIRONMENT=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tracera

COLLECTOR_TIMEOUT_SECONDS=10.0
COLLECTOR_MAX_RESPONSE_SIZE=2000000
COLLECTOR_MAX_REDIRECTS=5
COLLECTOR_USER_AGENT="Tracera/1.0 (+https://tracera.dev)"

SSRF_BLOCK_PRIVATE=true
SSRF_BLOCK_LOOPBACK=true
SSRF_BLOCK_LINK_LOCAL=true
SSRF_BLOCK_MULTICAST=true
SSRF_ALLOWED_SCHEMES=["http", "https"]

RATE_LIMIT_REQUESTS_PER_MINUTE=30

FEATURE_SCHEMA_VERSION=v1