# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tracera

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS: JSON array of allowed frontend origins (pydantic-settings parses complex
# types from the environment as JSON).
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Scanner resource limits
SCANNER_TIMEOUT_SECONDS=10.0          # Per-request timeout for the collector
SCANNER_CONNECT_TIMEOUT_SECONDS=5.0   # Connect timeout
SCANNER_TOTAL_TIME_SECONDS=25.0       # Total wall-clock budget per scan (all redirects)
SCANNER_MAX_RESPONSE_BYTES=10485760   # 10 MiB max response body
SCANNER_MAX_REDIRECTS=5               # Max redirects followed per scan
SCANNER_ALLOWED_PORTS=[80,443,8080,8443]  # Destination ports the collector may connect to

# Scan creation rate limiting (in-memory, per client IP, per worker process)
SCAN_RATE_LIMIT_MAX=10                # Max scan creations per window per client
SCAN_RATE_LIMIT_WINDOW_SECONDS=60     # Rate limit window in seconds

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
